# Local environments and credentials. Keep only sanitized examples.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Python caches, coverage, and package output.
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Frontend dependencies and build output.
frontend/node_modules/
frontend/dist/
frontend/.cache/

# Local observability data is user-owned runtime state.
/observability/data/

# IDE and editor-local metadata.
.idea/
.vscode/
*.iml
*.suo
*.user
*.swp
*~

# Operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Local vector indexes and test/tool caches.
*.faiss
**/index.pkl
**/docstore.pkl
.cache/

# Local project recreation examples and document exports.
/example/
/backend/static/projects/
