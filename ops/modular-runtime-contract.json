{
  "schema_version": "iteration5-modular-runtime-v1",
  "readiness_schema_version": "iteration5-readiness-v1",
  "auto_accept_current_values": false,
  "source_documents": {
    "backend_env_names": ".env.example",
    "frontend_env_names": "ez_front_dev/.env.example",
    "compose": "compose.yaml",
    "version_contract": "ops/version-contract.json"
  },
  "external_dependencies": [
    "mysql",
    "redis"
  ],
  "runner_owned": [
    "legacy-api",
    "agent-api",
    "worker",
    "frontend"
  ],
  "managed_start_order": [
    "legacy-api",
    "agent-api",
    "worker",
    "frontend"
  ],
  "managed_stop_order": [
    "frontend",
    "worker",
    "agent-api",
    "legacy-api"
  ],
  "modules": {
    "mysql": {
      "kind": "external",
      "runner_managed": false,
      "required_for": ["legacy-api"],
      "probe": "database-select-1-and-schema-read",
      "data_owner": "external-user-managed"
    },
    "redis": {
      "kind": "external",
      "runner_managed": false,
      "required_for": ["agent-api", "worker"],
      "probe": "redis-ping",
      "data_owner": "external-user-managed"
    },
    "legacy-api": {
      "kind": "managed-process",
      "runner_managed": true,
      "depends_on": ["mysql"],
      "working_dir": "ez_back_dev",
      "entrypoint": "serve.py",
      "command": ["python", "-B", "serve.py"],
      "host": "127.0.0.1",
      "port": 8130,
      "readiness": {
        "kind": "http",
        "method": "GET",
        "path": "/ready"
      },
      "compose_service": "legacy-api"
    },
    "agent-api": {
      "kind": "managed-process",
      "runner_managed": true,
      "depends_on": ["redis"],
      "working_dir": "ez_back_dev",
      "entrypoint": "app/agentApi.py",
      "command": ["python", "-B", "-m", "app.agentApi", "--port", "8131"],
      "host": "127.0.0.1",
      "port": 8131,
      "readiness": {
        "kind": "http",
        "method": "GET",
        "path": "/ready"
      },
      "compose_service": "agent-api"
    },
    "worker": {
      "kind": "managed-process",
      "runner_managed": true,
      "depends_on": ["redis", "agent-api"],
      "working_dir": "ez_back_dev",
      "entrypoint": "app/agentWorker.py",
      "command": ["python", "-B", "-m", "app.agentWorker", "--consumer", "modular-worker"],
      "readiness": {
        "kind": "agent-worker-heartbeat"
      },
      "compose_service": "worker"
    },
    "frontend": {
      "kind": "managed-process",
      "runner_managed": true,
      "depends_on": ["legacy-api", "agent-api", "worker"],
      "working_dir": "ez_front_dev",
      "entrypoint": "package.json",
      "command": ["npm", "run", "serve", "--", "--host", "127.0.0.1", "--port", "8080", "--strictPort"],
      "host": "127.0.0.1",
      "port": 8080,
      "readiness": {
        "kind": "http",
        "method": "GET",
        "path": "/"
      },
      "compose_service": "frontend"
    },
    "mcp": {
      "kind": "manual-optional",
      "runner_managed": false,
      "working_dir": "ez_back_dev",
      "entrypoint": "app/mcpServer.py",
      "port": 8011,
      "data_owner": "project-scope-supplied-by-operator"
    },
    "observability": {
      "kind": "compose-optional",
      "runner_managed": false,
      "data_owner": "existing-compose-volumes"
    }
  },
  "runtime_state": {
    "root": "system-temp/ezllmtest-modular-runtime",
    "repository_path_forbidden": true,
    "stores": ["pid", "start_time", "module", "port", "command_fingerprint", "status"],
    "stores_sensitive_values": false
  },
  "environment_policy": {
    "explicit_env_file_required_for": ["preflight", "start"],
    "implicit_env_discovery": false,
    "python_dotenv_disabled_value": "true",
    "frontend_env_dir_is_task_owned": true,
    "unknown_names_are_errors": true
  },
  "protected_operations": [
    "database-read-only",
    "redis-read-only",
    "no-compose-start",
    "no-compose-stop",
    "no-volume-operation",
    "no-provider-call",
    "no-project-discovery"
  ],
  "compose_crosscheck": {
    "services": [
      "frontend",
      "legacy-api",
      "agent-api",
      "worker",
      "mysql",
      "redis",
      "otel-collector",
      "prometheus",
      "tempo",
      "grafana"
    ],
    "loopback_published_ports": [8080, 8130, 8131, 9090, 3000]
  },
  "documentation": {
    "operator_guide": "docs/operations/modular-runtime.md",
    "portable_wrapper": "ops/modular/run.sh",
    "windows_wrapper": "ops/modular/run.ps1"
  }
}
