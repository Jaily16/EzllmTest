{
  "schema_version": "iteration5-modular-runtime-v1",
  "readiness_schema_version": "iteration5-readiness-v1",
  "auto_accept_current_values": false,
  "source_documents": {
    "backend_env_names": ".env.example",
    "frontend_env_names": "frontend/.env.example",
    "version_contract": "ops/version-contract.json"
  },
  "external_dependencies": [
    "mysql",
    "redis"
  ],
  "runner_owned": [
    "legacy-api",
    "agent-api",
    "worker",
    "frontend"
  ],
  "managed_start_order": [
    "legacy-api",
    "agent-api",
    "worker",
    "frontend"
  ],
  "managed_stop_order": [
    "frontend",
    "worker",
    "agent-api",
    "legacy-api"
  ],
  "modules": {
    "mysql": {
      "kind": "external",
      "runner_managed": false,
      "required_for": ["legacy-api"],
      "probe": "database-select-1-and-schema-read",
      "data_owner": "external-user-managed"
    },
    "redis": {
      "kind": "external",
      "runner_managed": false,
      "required_for": ["agent-api", "worker"],
      "probe": "redis-ping",
      "data_owner": "external-user-managed"
    },
    "legacy-api": {
      "kind": "managed-process",
      "runner_managed": true,
      "depends_on": ["mysql"],
      "working_dir": "backend",
      "entrypoint": "serve.py",
      "command": ["python", "-B", "serve.py"],
      "host": "127.0.0.1",
      "port": 8130,
      "readiness": {
        "kind": "http",
        "method": "GET",
        "path": "/ready"
      }
    },
    "agent-api": {
      "kind": "managed-process",
      "runner_managed": true,
      "depends_on": ["redis"],
      "working_dir": "backend",
      "entrypoint": "app/agentApi.py",
      "command": ["python", "-B", "-m", "app.agentApi", "--port", "8131"],
      "host": "127.0.0.1",
      "port": 8131,
      "readiness": {
        "kind": "http",
        "method": "GET",
        "path": "/ready"
      }
    },
    "worker": {
      "kind": "managed-process",
      "runner_managed": true,
      "depends_on": ["redis", "agent-api"],
      "working_dir": "backend",
      "entrypoint": "app/agentWorker.py",
      "command": ["python", "-B", "-m", "app.agentWorker", "--consumer", "modular-worker"],
      "readiness": {
        "kind": "agent-worker-heartbeat"
      }
    },
    "frontend": {
      "kind": "managed-process",
      "runner_managed": true,
      "depends_on": ["legacy-api", "agent-api", "worker"],
      "working_dir": "frontend",
      "entrypoint": "package.json",
      "command": ["node", "node_modules/vite/bin/vite.js", "--host", "127.0.0.1", "--port", "8080", "--strictPort"],
      "host": "127.0.0.1",
      "port": 8080,
      "readiness": {
        "kind": "http",
        "method": "GET",
        "path": "/"
      }
    },
    "mcp": {
      "kind": "manual-optional",
      "runner_managed": false,
      "working_dir": "backend",
      "entrypoint": "app/mcpServer.py",
      "port": 8011,
      "data_owner": "project-scope-supplied-by-operator"
    }
  },
  "runtime_state": {
    "root": "system-temp/ezllmtest-modular-runtime",
    "repository_path_forbidden": true,
    "stores": ["pid", "start_time", "module", "port", "command_fingerprint", "status"],
    "stores_sensitive_values": false
  },
  "environment_policy": {
    "explicit_env_file_required_for": ["preflight", "start"],
    "optional_model_env_file_argument": "--model-env-file",
    "optional_moonshot_model_argument": "--moonshot-model",
    "allowed_moonshot_model_override": "kimi-k3",
    "model_override_applied_after_validated_source_merge": true,
    "model_source_uses_fixed_allowlist": true,
    "model_source_cannot_override_infrastructure": true,
    "implicit_env_discovery": false,
    "python_dotenv_disabled_value": "true",
    "frontend_env_dir_is_task_owned": true,
    "unknown_names_are_errors": true
  },
  "protected_operations": [
    "database-read-only",
    "redis-read-only",
    "no-compose-start",
    "no-compose-stop",
    "no-volume-operation",
    "no-provider-call",
    "no-project-discovery"
  ],
  "documentation": {
    "operator_guide": "docs/operations/modular-runtime.md",
    "portable_wrapper": "ops/modular/run.sh",
    "windows_wrapper": "ops/modular/run.ps1"
  }
}
