# Backend runtime configuration. Fill backend/.env locally; never send secrets to chat.
# Preserve the CURRENT V6 database/account, Redis database and prefix. Do not use V2.
# DATABASE_URL uses mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/DATABASE?charset=utf8mb4
# Percent-encode reserved characters in URL credentials. Empty required fields fail closed.
DATABASE_URL=
AGENT_REDIS_URL=
AGENT_REDIS_PREFIX=

# Explicit alternatives: DATABASE_URL_FILE and the four *_API_KEY_FILE fields.
# Use an absolute ordinary file path and REMOVE the corresponding direct assignment.
# Direct and _FILE assignments cannot coexist, even when one is empty.

# Provider keys are optional until that provider is selected. Preserve your platform endpoint.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_CHAT_MODEL=glm-4.7
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_TIMEOUT_SECONDS=45
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.5-plus
DASHSCOPE_TIMEOUT_SECONDS=45
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45
MOONSHOT_API_KEY=
# China-platform credentials require the matching https://api.moonshot.cn/v1 endpoint.
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_CHAT_MODEL=kimi-k3
MOONSHOT_TIMEOUT_SECONDS=45

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8230
AGENT_API_PORT=8231
CORS_ORIGINS=http://127.0.0.1:8180,http://localhost:8180
AGENT_WORKER_GROUP=ezllm-agent-workers
AGENT_WORKER_HEARTBEAT_TTL_SECONDS=30
AGENT_CHECKPOINT_TTL_SECONDS=604800
AGENT_IDEMPOTENCY_TTL_SECONDS=604800
AGENT_CANCEL_TTL_SECONDS=604800
AGENT_EVENT_TTL_SECONDS=3600
AGENT_EVENT_MAX_LENGTH=2000
AGENT_LEASE_TTL_SECONDS=30
AGENT_LEASE_RENEW_SECONDS=10
AGENT_COMMAND_CLAIM_SECONDS=45
LANGGRAPH_STRICT_MSGPACK=true

# Whole-run budgets, NOT per-call caps. Changes apply only to newly created runs.
AGENT_FOCUSED_MAX_INPUT_TOKENS=768000
AGENT_FOCUSED_MAX_OUTPUT_TOKENS=393216
AGENT_STANDARD_MAX_INPUT_TOKENS=2048000
AGENT_STANDARD_MAX_OUTPUT_TOKENS=1048576
