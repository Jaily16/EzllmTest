# Database: replace the password before using this example.
DATABASE_URL=mysql+pymysql://ezllmtest_v2_app:replace_with_your_database_password@127.0.0.1:3306/ezllmtest_dev?charset=utf8mb4

# Zhipu GLM and embeddings
ZHIPU_API_KEY=replace_with_your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_CHAT_MODEL=glm-4.7
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_TIMEOUT_SECONDS=45

# Alibaba Cloud Model Studio (China/Beijing DashScope endpoint)
DASHSCOPE_API_KEY=replace_with_your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.5-plus
DASHSCOPE_TIMEOUT_SECONDS=45

# DeepSeek
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45

# Moonshot Kimi: use https://api.moonshot.cn/v1 for a China-platform key.
MOONSHOT_API_KEY=replace_with_your_moonshot_api_key
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_CHAT_MODEL=kimi-k2.5
MOONSHOT_TIMEOUT_SECONDS=45

# FastAPI
BACKEND_HOST=localhost
BACKEND_PORT=8130
CORS_ORIGINS=http://localhost:8080

# Iteration 4 Agent runtime (internal worker only; Redis must remain loopback/private)
AGENT_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_REDIS_PREFIX=ezllm:agent:v1
AGENT_CHECKPOINT_TTL_SECONDS=604800
AGENT_IDEMPOTENCY_TTL_SECONDS=604800
AGENT_CANCEL_TTL_SECONDS=604800
AGENT_EVENT_TTL_SECONDS=3600
AGENT_EVENT_MAX_LENGTH=2000
AGENT_LEASE_TTL_SECONDS=30
AGENT_LEASE_RENEW_SECONDS=10
AGENT_COMMAND_CLAIM_SECONDS=45
LANGGRAPH_STRICT_MSGPACK=true
AGENT_API_PORT=8131
AGENT_WORKER_HEARTBEAT_TTL_SECONDS=30

# Aspect 7 telemetry (disabled by default outside the controlled Compose stack)
AGENT_TELEMETRY_ENABLED=false
AGENT_OTLP_ENDPOINT=http://127.0.0.1:4317
AGENT_TELEMETRY_SERVICE_NAME=ezllm-agent
AGENT_OTEL_EXPORT_TIMEOUT_MS=2000
AGENT_OTEL_METRIC_INTERVAL_MS=30000

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=replace_with_your_langsmith_api_key
LANGCHAIN_PROJECT=ezllmtest-dev
